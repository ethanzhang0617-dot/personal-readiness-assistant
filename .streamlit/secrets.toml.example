# Every setting is optional. Do not commit a real secrets.toml file.
# Without any setting, Demo Mode, browser-local My Local Data and the
# deterministic Coach all work; only the AI explanation layer stays off.

# DeepSeek API key for the optional AI explanation layer.
# Read from Streamlit secrets first, then from the DEEPSEEK_API_KEY environment
# variable. Never commit a real key, print it, or send it to the frontend.
DEEPSEEK_API_KEY = "your-key-here"

# Optional overrides. The defaults are already correct for the product.
# DEEPSEEK_MODEL = "deepseek-flash"
# DEEPSEEK_BASE_URL = "https://api.deepseek.com"

# Disable AI explanations while preserving deterministic Coach answers.
# DISABLE_AI_COACH = "true"
