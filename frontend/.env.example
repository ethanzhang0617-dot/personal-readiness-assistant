# Frontend runtime configuration — safe example file, no secrets.
#
# Copy to `.env.local` for local development (that file is gitignored):
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle, so:
#   * never put an API key, token or password here;
#   * set it BEFORE `pnpm build` when deploying, because the production bundle
#     bakes the value in at build time.
#
# The DeepSeek credential lives only on the FastAPI server and is never sent to
# the browser.

# Where the browser should call the API.
# Local development (default when unset):
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Testing from a phone on the same Wi-Fi (replace with your machine's LAN IP,
# and start the backend with --host 0.0.0.0):
# NEXT_PUBLIC_API_BASE_URL=http://192.168.1.20:8000

# Deployed backend example:
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
